{
  "name": "ascent-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Project ASCENT — Pathway Builder. Front-end mockup (no backend), built section by section.",
  "scripts": {
    "dev": "vite --port 5320 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5321 --strictPort",
